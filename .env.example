# ==============================================================================
# WetterExtended — Umgebungsvariablen
# Kopiere diese Datei als .env und trage deine Werte ein.
# WICHTIG: .env NIEMALS committen (steht in .gitignore)
#          Alle Tokens/Passwörter NUR hier — NIE in config.py oder Source-Code
# ==============================================================================

# ── FTP-Upload (Radar-Overlay auf eigenen Webserver) ─────────────────────────
FTP_SERVER=your-ftp-server.example.com
FTP_USER=your_ftp_user
FTP_PASS=your_ftp_password
FTP_PATH=/wetterAI/

# ── Blitzortung.org (Teilnehmer-Login) ───────────────────────────────────────
# Registrierung: https://www.blitzortung.org/en/login.php
BLITZ_USERNAME=your_blitzortung_username
BLITZ_PASSWORD=your_blitzortung_password

# ── Twilio SMS-Warnungen ──────────────────────────────────────────────────────
# Account anlegen: https://www.twilio.com/
# Leer lassen = SMS-Warnungen deaktiviert
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+43...
TWILIO_TO=+43...

# ── Anthropic API (KI-Analyse-Chat im Admin-Panel) ───────────────────────────
# API-Key anlegen: https://console.anthropic.com/
# Leer lassen = KI-Analyse deaktiviert
ANTHROPIC_API_KEY=

# ── GitHub-Token (privates Repo — für KI-Analyse: Quellcode laden) ───────────
# Token anlegen: GitHub → Settings → Developer Settings → Personal Access Tokens
# Benötigte Berechtigung: repo:read (read-only)
GITHUB_TOKEN=

# ── Debug-Modus ───────────────────────────────────────────────────────────────
# 1 = ausführliche Logs + Debug-Bilder speichern
# Achtung: erhöht I/O-Last auf dem Pi — nur für Fehlersuche!
WETTER_DEBUG=0
