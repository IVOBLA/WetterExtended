# ==============================================================================
# WetterExtended — .gitignore
# Binäre Artefakte, generierte Daten und Secrets werden NICHT committed.
# WICHTIG: Modell-Binaries (.keras, .h5, .hef, .joblib, .onnx, .npz)
#          können NICHT über git push verteilt werden.
#          Bereitstellung als separater Download (GitHub Releases, rsync).
# ==============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
*.pyc
*.pyo
__pycache__/
*.pyd
*.so

# ── Virtuelle Umgebung ────────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Modell-Binaries (dürfen NICHT ins Git) ───────────────────────────────────
*.keras
*.h5
*.txt.lgb
*.joblib
*.pkl
*.onnx
*.hef
models/hailo/
*.npz
*.parquet

# ── Trainingsdaten und generierte Dateien ─────────────────────────────────────
/train_data/
/data/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
# B469: auch Sicherungskopien wie .env_Copy, .env.bak oder .env~ nie committen.
.env*
!.env.example
train_data/runtime_overrides.json

# ── Generierte Bilder / Exports ───────────────────────────────────────────────
*.png
*.gif
*.kmz
plots/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Frontend-Build ────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Persistente Hydro-Admin-Overrides
data/config/hydro_station_overrides.json
