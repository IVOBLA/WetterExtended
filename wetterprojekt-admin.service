[Unit]
Description=Wetterprojekt Admin Panel (Flask + React)
After=network.target
# B145: kein dauerhaftes "failed" nach mehreren Crashes — Self-Healing.
# StartLimitIntervalSec=0 deaktiviert die Start-Rate-Begrenzung; systemd startet
# den Dienst nach jedem Absturz erneut (Backoff via RestartSec).
StartLimitIntervalSec=0

[Service]
Type=simple
User=ki-pi
WorkingDirectory=/home/ki-pi/wetterprojekt
ExecStart=/home/ki-pi/wetterprojekt/venv/bin/python3 /home/ki-pi/wetterprojekt/app.py
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1
Environment=ADMIN_BIND_HOST=127.0.0.1
Environment=ADMIN_BIND_PORT=5000

[Install]
WantedBy=multi-user.target
