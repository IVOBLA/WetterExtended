[Unit]
Description=WetterExtended lokale Code-/Betriebsanalyse (Claude Code, headless)
Documentation=file:/home/ki-pi/wetterprojekt/docs/LOCAL_ANALYSIS_PROMPT.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ki-pi
WorkingDirectory=/home/ki-pi/wetterprojekt
Environment=PYTHONUNBUFFERED=1
# systemd-Units erben ~/.bashrc NICHT — die Claude-Code-CLI liegt in ~/.local/bin.
Environment=PATH=/home/ki-pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DISABLE_AUTOUPDATER=1
# Sandbox: Systempfade schreibgeschuetzt, .env fuer diesen Prozess unzugaenglich.
# Kernel-erzwungen und damit unabhaengig von den Allow/Deny-Regeln der CLI.
NoNewPrivileges=yes
PrivateTmp=yes
# B466: strict statt full — alles ausserhalb der ReadWritePaths ist
# schreibgeschuetzt, kernel-erzwungen. Selbst wenn ein Kommando an der
# Werkzeug-Positivliste vorbeikaeme, ist kein Schreibzugriff auf Quellcode,
# Modelle oder Rohdaten moeglich.
ProtectSystem=strict
ReadWritePaths=/home/ki-pi/wetterprojekt/train_data/evaluation
ReadWritePaths=-/home/ki-pi/.claude
ReadWritePaths=-/home/ki-pi/.cache
ReadWritePaths=-/home/ki-pi/.config
ProtectKernelTunables=yes
ProtectControlGroups=yes
InaccessiblePaths=-/home/ki-pi/wetterprojekt/.env
# Zeitlimit oberhalb von LOCAL_ANALYSIS_CONFIG["timeout_s"] — der Runner beendet
# sich normalerweise selbst; das hier ist nur der Notausgang.
# B517: von 1800 auf 3600 angehoben, mit 300s Marge ueber der neuen
# timeout_s-Obergrenze (3300, app.py). Vorfall 2026-08-06/07: timeout_s war per
# Admin-Panel auf 3000 gesetzt, ueberschritt damit das alte TimeoutStartSec=1800
# bereits deutlich -- systemd killte den Prozess per SIGTERM, lange bevor
# Pythons eigener subprocess.run(timeout=...)-Handler je greifen konnte. Wird
# dieser Wert nochmal geaendert, MUSS die Validierungsobergrenze in app.py
# (Suche "B517") mit mindestens 300s Marge nachgezogen werden.
TimeoutStartSec=3600
ExecStart=/home/ki-pi/wetterprojekt/venv/bin/python3 /home/ki-pi/wetterprojekt/tools/run_local_analysis.py --repo-dir /home/ki-pi/wetterprojekt
